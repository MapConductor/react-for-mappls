{
  "name": "@mapconductor/react-for-mappls",
  "version": "0.3.0",
  "description": "Mappls (MapmyIndia) provider for MapConductor React SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "clean": "rm -rf dist",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "maps",
    "mappls",
    "mapmyindia",
    "mapbox-gl",
    "react",
    "typescript"
  ],
  "author": "MapConductor",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@mapconductor/js-sdk-core": "^0.3.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@mapconductor/js-sdk-core": "^0.3.0",
    "@mapconductor/js-sdk-react": "^0.3.0",
    "mappls-web-maps": "^3.8.1"
  },
  "devDependencies": {
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
